<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- Production: HTTPS only -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>

    <!-- Debug: allow user-installed certificates -->
    <debug-overrides>
        <trust-anchors>
            <certificates src="user" />
            <certificates src="system" />
        </trust-anchors>
    </debug-overrides>

    <!-- Allow cleartext to ARIS internal IPs (prod + staging) -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.202.101.183</domain>
        <domain includeSubdomains="false">10.202.101.184</domain>
        <domain includeSubdomains="false">10.202.101.186</domain>
        <domain includeSubdomains="false">10.202.101.146</domain>
        <domain includeSubdomains="false">10.202.101.147</domain>
        <domain includeSubdomains="false">10.202.101.148</domain>
        <domain includeSubdomains="false">10.202.101.149</domain>
    </domain-config>

    <!-- Staging: trust system CAs (no pinning — cert rotates frequently) -->
    <domain-config>
        <domain includeSubdomains="true">test.au-aris.org</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>

    <!-- Production: trust system CAs (no pinning — cert rotates with Let's Encrypt) -->
    <domain-config>
        <domain includeSubdomains="true">au-aris.org</domain>
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </domain-config>
</network-security-config>
