{
  "name": "@aris/ingest-service",
  "version": "0.1.0",
  "private": true,
  "description": "ARIS 4.0 — Ingest service: intelligent file import, profiling, matching, loading",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc --build",
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "clean": "rm -rf dist tsconfig.tsbuildinfo",
    "lint": "eslint src/",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@aris/access-control": "workspace:*",
    "@aris/auth-middleware": "workspace:*",
    "@aris/kafka-client": "workspace:*",
    "@aris/shared-types": "workspace:*",
    "@fastify/cors": "^10.0.0",
    "@fastify/helmet": "^12.0.0",
    "@fastify/multipart": "^9.0.0",
    "@opensearch-project/opensearch": "^2.12.0",
    "@prisma/client": "^6.2.0",
    "@sinclair/typebox": "^0.34.0",
    "csv-parse": "^5.5.0",
    "dotenv": "^17.3.1",
    "exceljs": "^4.4.0",
    "fastify": "^5.0.0",
    "fastify-plugin": "^5.0.0",
    "file-type": "^19.0.0",
    "ioredis": "^5.9.3",
    "jsonwebtoken": "^9.0.0",
    "minio": "^8.0.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.0",
    "@types/uuid": "^9.0.0",
    "prisma": "^6.2.0",
    "tsx": "^4.11.0",
    "typescript": "^5.4.0",
    "vitest": "^1.6.0"
  }
}
