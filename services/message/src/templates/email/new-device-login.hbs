<!-- new-device-login.hbs — Security alert for new or suspicious login activity -->
<table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
  <tr>
    <td style="padding-bottom: 24px;">

      <!-- Greeting -->
      <p style="margin: 0 0 16px 0; font-family: Arial, Helvetica, sans-serif; font-size: 16px; color: #333333;">
        Hello <strong>{{firstName}} {{lastName}}</strong>,
      </p>

      {{#if isNewDevice}}
      <!-- New device alert -->
      <p style="margin: 0 0 16px 0; font-family: Arial, Helvetica, sans-serif; font-size: 16px; color: #333333;">
        We noticed a login to your ARIS account from a <strong>new device</strong> that we do not recognise.
      </p>
      {{else}}
      <!-- Known device / multi-session alert -->
      <p style="margin: 0 0 16px 0; font-family: Arial, Helvetica, sans-serif; font-size: 16px; color: #333333;">
        A new login to your ARIS account has been detected.
      </p>
      {{/if}}

      <!-- Login details box -->
      <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
             style="margin: 16px 0 24px 0; border: 1px solid #e0e0e0; border-radius: 6px; overflow: hidden;">
        <tr>
          <td style="background-color: #f8f9fa; padding: 6px 16px; font-family: Arial, Helvetica, sans-serif;
                     font-size: 12px; font-weight: bold; color: #666666; text-transform: uppercase;
                     letter-spacing: 0.5px; border-bottom: 1px solid #e0e0e0;">
            Login Details
          </td>
        </tr>
        <tr>
          <td style="padding: 0;">
            <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%">
              <tr>
                <td style="padding: 10px 16px; font-family: Arial, Helvetica, sans-serif; font-size: 14px;
                           color: #555555; border-bottom: 1px solid #f0f0f0; width: 36%;">
                  <strong>Device</strong>
                </td>
                <td style="padding: 10px 16px; font-family: Arial, Helvetica, sans-serif; font-size: 14px;
                           color: #333333; border-bottom: 1px solid #f0f0f0;">
                  {{deviceName}}
                </td>
              </tr>
              <tr>
                <td style="padding: 10px 16px; font-family: Arial, Helvetica, sans-serif; font-size: 14px;
                           color: #555555; border-bottom: 1px solid #f0f0f0;">
                  <strong>Type</strong>
                </td>
                <td style="padding: 10px 16px; font-family: Arial, Helvetica, sans-serif; font-size: 14px;
                           color: #333333; border-bottom: 1px solid #f0f0f0; text-transform: capitalize;">
                  {{deviceType}}
                </td>
              </tr>
              <tr>
                <td style="padding: 10px 16px; font-family: Arial, Helvetica, sans-serif; font-size: 14px;
                           color: #555555; border-bottom: 1px solid #f0f0f0;">
                  <strong>IP Address</strong>
                </td>
                <td style="padding: 10px 16px; font-family: Arial, Helvetica, sans-serif; font-size: 14px;
                           color: #333333; border-bottom: 1px solid #f0f0f0; font-family: monospace;">
                  {{ipAddress}}
                </td>
              </tr>
              <tr>
                <td style="padding: 10px 16px; font-family: Arial, Helvetica, sans-serif; font-size: 14px;
                           color: #555555;">
                  <strong>Date &amp; Time</strong>
                </td>
                <td style="padding: 10px 16px; font-family: Arial, Helvetica, sans-serif; font-size: 14px;
                           color: #333333;">
                  {{loginAt}}
                </td>
              </tr>
            </table>
          </td>
        </tr>
      </table>

      <!-- Security warning -->
      <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
             style="margin-bottom: 20px;">
        <tr>
          <td style="background-color: #fff3cd; border-left: 4px solid #ffc107; padding: 14px 16px;
                     font-family: Arial, Helvetica, sans-serif; font-size: 14px; color: #856404; border-radius: 0 4px 4px 0;">
            <strong>&#9888; Security Notice:</strong> If you did not perform this login, your account may be
            compromised. Please change your password immediately and contact your system administrator.
          </td>
        </tr>
      </table>

      <!-- CTA -->
      <p style="margin: 0 0 8px 0; font-family: Arial, Helvetica, sans-serif; font-size: 14px; color: #555555;">
        If this was you, no action is required. If it was not you, secure your account immediately:
      </p>

      <table role="presentation" cellspacing="0" cellpadding="0" border="0" style="margin: 16px 0;">
        <tr>
          <td style="border-radius: 6px; background-color: #c0392b;">
            <a href="{{dashboardUrl}}/settings/security"
               target="_blank"
               style="display: inline-block; padding: 12px 28px; font-family: Arial, Helvetica, sans-serif;
                      font-size: 15px; font-weight: bold; color: #ffffff; text-decoration: none; border-radius: 6px;">
              Secure My Account
            </a>
          </td>
        </tr>
      </table>

      <!-- Note about multiple connections -->
      {{#if allowMultipleConnections}}
      <table role="presentation" cellspacing="0" cellpadding="0" border="0" width="100%"
             style="margin-top: 16px;">
        <tr>
          <td style="background-color: #e8f4fd; border-left: 4px solid #2196f3; padding: 12px 16px;
                     font-family: Arial, Helvetica, sans-serif; font-size: 13px; color: #1565c0; border-radius: 0 4px 4px 0;">
            <strong>Information:</strong> Your organisation allows simultaneous connections on multiple devices.
            You will receive this notification for every login to keep you informed of account activity.
          </td>
        </tr>
      </table>
      {{/if}}

    </td>
  </tr>
</table>
