// ARIS 4.0 — User / Credential Model
// Authentication, authorization, user management

enum UserRole {
  SUPER_ADMIN
  CONTINENTAL_ADMIN
  REC_ADMIN
  NATIONAL_ADMIN
  DATA_STEWARD
  WAHIS_FOCAL_POINT
  ANALYST
  FIELD_AGENT
  KNOWLEDGE_MANAGER
  NATIONAL_LABORATORY
  REGIONAL_LABORATORY
  CONTINENTAL_LABORATORY
  PAID_ADMIN
  DECISION_MAKER

  @@map("user_role")
  @@schema("public")
}

enum SessionStatus {
  ACTIVE
  EXPIRED
  LOGGED_OUT
  REVOKED

  @@map("session_status")
  @@schema("public")
}

model User {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  email              String    @unique @db.VarChar(255)
  passwordHash       String    @map("password_hash") @db.VarChar(255)
  firstName          String    @map("first_name") @db.VarChar(100)
  lastName           String    @map("last_name") @db.VarChar(100)
  phone              String?   @db.VarChar(20)
  role               UserRole
  mfaEnabled         Boolean   @default(false) @map("mfa_enabled")
  mfaSecret          String?   @map("mfa_secret") @db.VarChar(255)
  locale             String    @default("en") @db.VarChar(5)
  avatarUrl          String?   @map("avatar_url") @db.Text
  lastLoginAt        DateTime? @map("last_login_at") @db.Timestamptz
  isActive           Boolean   @default(true) @map("is_active")
  mustChangePassword Boolean   @default(false) @map("must_change_password")
  passwordChangedAt  DateTime? @map("password_changed_at") @db.Timestamptz
  accountExpiresAt   DateTime? @map("account_expires_at") @db.Timestamptz // Temporary accounts: null = permanent, set = expires at this date
  permissions        Json? // Sub-domain permissions: { "livestock-prod": ["DAIRY","RED_MEAT"], "trade-sps": ["*"] }
  adminDivisionIds   String[]  @default([]) @map("admin_division_ids") @db.Uuid // GeoEntity UUIDs restricting user to specific admin divisions (admin1/admin2/...)
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant          Tenant               @relation(fields: [tenantId], references: [id])
  functions       UserFunction[]
  userDomains     UserDomain[]
  roleAssignments UserRoleAssignment[]
  devices         UserDevice[]

  sessions SessionLog[]
  mdmDevices MdmDevice[] @relation("MdmDevices")

  // Collecte workflow relations
  collecteValidationChainsAsUser      CollecteValidationChain[] @relation("UserCollecteValidators")
  collecteValidationChainsAsValidator CollecteValidationChain[] @relation("CollecteValidatorFor")
  collecteValidationChainsAsBackup    CollecteValidationChain[] @relation("CollecteBackupValidatorFor")
  campaignAssignments                 CampaignAssignment[]

  @@index([tenantId], map: "idx_user_tenant_id")
  @@index([role], map: "idx_user_role")
  @@index([isActive], map: "idx_user_is_active")
  @@map("users")
  @@schema("public")
}

// Tracks known devices per user for security alerts and concurrent session management
model UserDevice {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  fingerprint String   @db.VarChar(64) // SHA-256 of User-Agent (first 32 hex chars)
  deviceName  String   @map("device_name") @db.VarChar(255) // e.g. "Chrome on Windows"
  deviceType  String   @map("device_type") @db.VarChar(10) // "web" | "mobile"
  isTrusted   Boolean  @default(true) @map("is_trusted")
  firstSeenAt DateTime @default(now()) @map("first_seen_at") @db.Timestamptz
  lastSeenAt  DateTime @updatedAt @map("last_seen_at") @db.Timestamptz
  lastIp      String?  @map("last_ip") @db.VarChar(45)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprint])
  @@index([userId])
  @@map("user_devices")
  @@schema("public")
}

model SessionLog {
  id             String        @id @default(uuid()) @db.Uuid
  userId         String        @map("user_id") @db.Uuid
  tenantId       String        @map("tenant_id") @db.Uuid
  refreshTokenId String        @map("refresh_token_id") @db.VarChar(36)
  status         SessionStatus @default(ACTIVE)

  // Device info (denormalized for query independence)
  deviceName  String  @map("device_name") @db.VarChar(255)
  deviceType  String  @map("device_type") @db.VarChar(10)
  fingerprint String  @db.VarChar(64)
  userAgent   String? @map("user_agent") @db.Text

  // Network / geolocation
  ipAddress   String  @map("ip_address") @db.VarChar(45)
  country     String? @db.VarChar(100)
  countryCode String? @map("country_code") @db.VarChar(2)
  city        String? @db.VarChar(100)
  latitude    Float?
  longitude   Float?

  // Timestamps
  loginAt        DateTime  @default(now()) @map("login_at") @db.Timestamptz
  lastActivityAt DateTime  @default(now()) @map("last_activity_at") @db.Timestamptz
  logoutAt       DateTime? @map("logout_at") @db.Timestamptz
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_session_log_user")
  @@index([tenantId], map: "idx_session_log_tenant")
  @@index([status], map: "idx_session_log_status")
  @@index([loginAt], map: "idx_session_log_login_at")
  @@index([country], map: "idx_session_log_country")
  @@index([refreshTokenId], map: "idx_session_log_token")
  @@map("session_logs")
  @@schema("public")
}

// ── User Scope Access Levels ──────────────────────────────────────────
// Maps a user to their access levels on each domain/subdomain node.

model UserScopeAccessLevel {
  userId    String @map("user_id") @db.Uuid
  nodeCode  String @map("node_code") @db.VarChar(120)
  levelCode String @map("level_code") @db.VarChar(60)

  @@id([userId, nodeCode, levelCode])
  @@index([nodeCode, levelCode], map: "idx_usal_node_level")
  @@map("user_scope_access_levels")
  @@schema("public")
}

// ── MDM Device ──
model MdmDevice {
  id              String    @id @default(uuid()) @db.Uuid
  tenantId        String    @map("tenant_id") @db.Uuid
  userId          String    @map("user_id") @db.Uuid
  deviceToken     String    @unique @map("device_token") @db.VarChar(64)
  hardwareId      String    @unique @map("hardware_id") @db.VarChar(255)
  deviceName      String    @map("device_name") @db.VarChar(255)
  deviceModel     String    @map("device_model") @db.VarChar(255)
  manufacturer    String    @default("") @db.VarChar(100)
  osVersion       String    @map("os_version") @db.VarChar(50)
  appVersion      String    @map("app_version") @db.VarChar(50)
  screenResolution String?  @map("screen_resolution") @db.VarChar(30)
  totalStorageMb  Int?      @map("total_storage_mb")
  totalRamMb      Int?      @map("total_ram_mb")
  // Dynamic fields (updated by heartbeat)
  batteryLevel    Int?      @map("battery_level")
  isCharging      Boolean   @default(false) @map("is_charging")
  networkType     String?   @map("network_type") @db.VarChar(20)
  storageFreeMb   Int?      @map("storage_free_mb")
  lastSyncAt      DateTime? @map("last_sync_at") @db.Timestamptz
  pendingSyncItems Int      @default(0) @map("pending_sync_items")
  lastLocation    Json?     @map("last_location")
  lastHeartbeatAt DateTime? @map("last_heartbeat_at") @db.Timestamptz
  status          String    @default("ACTIVE") @db.VarChar(20)
  enrolledAt      DateTime  @default(now()) @map("enrolled_at") @db.Timestamptz
  updatedAt       DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  user     User          @relation("MdmDevices", fields: [userId], references: [id], onDelete: Cascade)
  commands MdmCommand[]
  heartbeats MdmHeartbeat[]

  @@index([tenantId])
  @@index([userId])
  @@index([status])
  @@map("mdm_devices")
  @@schema("public")
}

// ── MDM Command ──
model MdmCommand {
  id          String    @id @default(uuid()) @db.Uuid
  deviceId    String    @map("device_id") @db.Uuid
  type        String    @db.VarChar(30)
  status      String    @default("PENDING") @db.VarChar(20)
  payload     Json?     @default("{}")
  result      Json?
  issuedBy    String    @map("issued_by") @db.Uuid
  issuedAt    DateTime  @default(now()) @map("issued_at") @db.Timestamptz
  deliveredAt DateTime? @map("delivered_at") @db.Timestamptz
  executedAt  DateTime? @map("executed_at") @db.Timestamptz
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz

  device MdmDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, status])
  @@map("mdm_commands")
  @@schema("public")
}

// ── MDM Heartbeat Log (for graphs) ──
model MdmHeartbeat {
  id           String   @id @default(uuid()) @db.Uuid
  deviceId     String   @map("device_id") @db.Uuid
  batteryLevel Int?     @map("battery_level")
  isCharging   Boolean  @default(false) @map("is_charging")
  networkType  String?  @map("network_type") @db.VarChar(20)
  storageFreeMb Int?    @map("storage_free_mb")
  appVersion   String?  @map("app_version") @db.VarChar(50)
  pendingSyncItems Int  @default(0) @map("pending_sync_items")
  location     Json?
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz

  device MdmDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)

  @@index([deviceId, createdAt])
  @@map("mdm_heartbeats")
  @@schema("public")
}

// ── MDM App Release (OTA) ──
model MdmAppRelease {
  id           String   @id @default(uuid()) @db.Uuid
  tenantId     String   @map("tenant_id") @db.Uuid
  versionName  String   @map("version_name") @db.VarChar(50)
  versionCode  Int      @map("version_code")
  releaseNotes String?  @map("release_notes") @db.Text
  fileName     String   @map("file_name") @db.VarChar(255)
  fileSize     Int      @map("file_size")
  fileSha256   String   @map("file_sha256") @db.VarChar(64)
  fileUrl      String   @map("file_url") @db.Text
  packageName  String   @default("org.auibar.aris") @map("package_name") @db.VarChar(200)
  isRequired   Boolean  @default(false) @map("is_required")
  isActive     Boolean  @default(true) @map("is_active")
  targetDevices Json?   @map("target_devices")
  publishedBy  String   @map("published_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([tenantId, versionCode])
  @@index([tenantId, isActive])
  @@map("mdm_app_releases")
  @@schema("public")
}
