// ARIS 4.0 — User / Credential Model
// Authentication, authorization, user management

enum UserRole {
  SUPER_ADMIN
  CONTINENTAL_ADMIN
  REC_ADMIN
  NATIONAL_ADMIN
  DATA_STEWARD
  WAHIS_FOCAL_POINT
  ANALYST
  FIELD_AGENT
  KNOWLEDGE_MANAGER
  NATIONAL_LABORATORY
  REGIONAL_LABORATORY
  CONTINENTAL_LABORATORY

  @@map("user_role")
  @@schema("public")
}

enum SessionStatus {
  ACTIVE
  EXPIRED
  LOGGED_OUT
  REVOKED

  @@map("session_status")
  @@schema("public")
}

model User {
  id           String    @id @default(uuid()) @db.Uuid
  tenantId     String    @map("tenant_id") @db.Uuid
  email        String    @unique @db.VarChar(255)
  passwordHash String    @map("password_hash") @db.VarChar(255)
  firstName    String    @map("first_name") @db.VarChar(100)
  lastName     String    @map("last_name") @db.VarChar(100)
  phone        String?   @db.VarChar(20)
  role         UserRole
  mfaEnabled   Boolean   @default(false) @map("mfa_enabled")
  mfaSecret    String?   @map("mfa_secret") @db.VarChar(255)
  locale       String    @default("en") @db.VarChar(5)
  avatarUrl    String?   @map("avatar_url") @db.Text
  lastLoginAt  DateTime? @map("last_login_at") @db.Timestamptz
  isActive     Boolean   @default(true) @map("is_active")
  mustChangePassword Boolean  @default(false) @map("must_change_password")
  passwordChangedAt  DateTime? @map("password_changed_at") @db.Timestamptz
  accountExpiresAt   DateTime? @map("account_expires_at") @db.Timestamptz  // Temporary accounts: null = permanent, set = expires at this date
  permissions  Json?    // Sub-domain permissions: { "livestock-prod": ["DAIRY","RED_MEAT"], "trade-sps": ["*"] }
  adminDivisionIds String[] @default([]) @map("admin_division_ids") @db.Uuid  // GeoEntity UUIDs restricting user to specific admin divisions (admin1/admin2/...)
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  tenant    Tenant         @relation(fields: [tenantId], references: [id])
  functions UserFunction[]
  userDomains UserDomain[]
  roleAssignments UserRoleAssignment[]
  devices   UserDevice[]

  sessions  SessionLog[]

  // Collecte workflow relations
  collecteValidationChainsAsUser      CollecteValidationChain[] @relation("UserCollecteValidators")
  collecteValidationChainsAsValidator CollecteValidationChain[] @relation("CollecteValidatorFor")
  collecteValidationChainsAsBackup    CollecteValidationChain[] @relation("CollecteBackupValidatorFor")
  campaignAssignments                 CampaignAssignment[]

  @@index([tenantId], map: "idx_user_tenant_id")
  @@index([role], map: "idx_user_role")
  @@index([isActive], map: "idx_user_is_active")
  @@map("users")
  @@schema("public")
}

// Tracks known devices per user for security alerts and concurrent session management
model UserDevice {
  id          String   @id @default(uuid()) @db.Uuid
  userId      String   @map("user_id") @db.Uuid
  fingerprint String   @db.VarChar(64)   // SHA-256 of User-Agent (first 32 hex chars)
  deviceName  String   @map("device_name") @db.VarChar(255) // e.g. "Chrome on Windows"
  deviceType  String   @map("device_type") @db.VarChar(10)  // "web" | "mobile"
  isTrusted   Boolean  @default(true) @map("is_trusted")
  firstSeenAt DateTime @default(now()) @map("first_seen_at") @db.Timestamptz
  lastSeenAt  DateTime @updatedAt @map("last_seen_at") @db.Timestamptz
  lastIp      String?  @map("last_ip") @db.VarChar(45)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, fingerprint])
  @@index([userId])
  @@map("user_devices")
  @@schema("public")
}

model SessionLog {
  id              String        @id @default(uuid()) @db.Uuid
  userId          String        @map("user_id") @db.Uuid
  tenantId        String        @map("tenant_id") @db.Uuid
  refreshTokenId  String        @map("refresh_token_id") @db.VarChar(36)
  status          SessionStatus @default(ACTIVE)

  // Device info (denormalized for query independence)
  deviceName      String        @map("device_name") @db.VarChar(255)
  deviceType      String        @map("device_type") @db.VarChar(10)
  fingerprint     String        @db.VarChar(64)
  userAgent       String?       @map("user_agent") @db.Text

  // Network / geolocation
  ipAddress       String        @map("ip_address") @db.VarChar(45)
  country         String?       @db.VarChar(100)
  countryCode     String?       @map("country_code") @db.VarChar(2)
  city            String?       @db.VarChar(100)
  latitude        Float?
  longitude       Float?

  // Timestamps
  loginAt         DateTime      @default(now()) @map("login_at") @db.Timestamptz
  lastActivityAt  DateTime      @default(now()) @map("last_activity_at") @db.Timestamptz
  logoutAt        DateTime?     @map("logout_at") @db.Timestamptz
  expiresAt       DateTime      @map("expires_at") @db.Timestamptz

  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "idx_session_log_user")
  @@index([tenantId], map: "idx_session_log_tenant")
  @@index([status], map: "idx_session_log_status")
  @@index([loginAt], map: "idx_session_log_login_at")
  @@index([country], map: "idx_session_log_country")
  @@index([refreshTokenId], map: "idx_session_log_token")
  @@map("session_logs")
  @@schema("public")
}
