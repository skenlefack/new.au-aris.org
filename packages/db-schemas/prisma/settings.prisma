// ARIS 4.0 — Settings Models
// Managed by: tenant service (port 3001)
// Schema: governance
// RECs, Countries, SystemConfig, Domains for the Settings module + public landing page.

model Rec {
  id            String       @id @default(uuid()) @db.Uuid
  code          String       @unique @db.VarChar(20)
  name          Json         // { "en": "ECOWAS", "fr": "CEDEAO", "pt": "CEDEAO", "ar": "..." }
  fullName      Json         @map("full_name")
  description   Json
  region        Json         // { "en": "West Africa", "fr": "Afrique de l'Ouest", ... }
  headquarters  String       @db.VarChar(255)
  established   Int?
  accentColor   String       @map("accent_color") @db.VarChar(20)
  logoUrl       String?      @map("logo_url") @db.VarChar(500)
  website       String?      @db.VarChar(500)
  currency      String?      @db.VarChar(10)  // ISO 4217 currency code (e.g. XOF, USD, KES)
  isActive      Boolean      @default(true) @map("is_active")
  sortOrder     Int          @default(0) @map("sort_order")
  stats         Json?        // { activeCampaigns: 12, reportsSubmitted: 450, ... }
  metadata      Json?
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  countries     CountryRec[]

  @@index([isActive], map: "idx_rec_is_active")
  @@index([sortOrder], map: "idx_rec_sort_order")
  @@map("recs")
  @@schema("governance")
}

model Country {
  id                String       @id @default(uuid()) @db.Uuid
  code              String       @unique @db.VarChar(2)     // ISO 3166-1 alpha-2
  code3             String?      @db.VarChar(3)             // ISO 3166-1 alpha-3
  name              Json         // { "en": "Kenya", "fr": "Kenya", "pt": "Quénia", "ar": "كينيا" }
  officialName      Json?        @map("official_name")
  capital           Json         // { "en": "Nairobi", ... }
  flag              String       @db.VarChar(20)            // emoji flag
  population        BigInt?      // total population
  area              Float?       // km²
  timezone          String?      @db.VarChar(50)
  languages         Json?        // ["sw", "en"]
  currency          String?      @db.VarChar(10)
  phoneCode         String?      @map("phone_code") @db.VarChar(10)
  isActive          Boolean      @default(false) @map("is_active")
  isOperational     Boolean      @default(false) @map("is_operational")
  tenantId          String?      @map("tenant_id") @db.Uuid
  sortOrder         Int          @default(0) @map("sort_order")
  stats             Json?        // { activeOutbreaks: 6, vaccinationCoverage: 52, ... }
  sectorPerformance Json?        @map("sector_performance") // { vaccination: 52, fisheries: 74, ... }
  welcomeMessage    String?      @map("welcome_message") @db.Text  // HTML content for inactive country landing page
  metadata          Json?
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  recs              CountryRec[]
  adminLevels       AdminLevel[]
  tenant            Tenant?      @relation(fields: [tenantId], references: [id])
  collecteWorkflow  CollecteWorkflow?
  countryStatistics CountryStatistic[]
  kpiScores         CountryKpiScore[]

  @@index([isActive], map: "idx_country_is_active")
  @@index([isOperational], map: "idx_country_is_operational")
  @@index([tenantId], map: "idx_country_tenant_id")
  @@map("countries")
  @@schema("governance")
}

model CountryRec {
  id         String    @id @default(uuid()) @db.Uuid
  countryId  String    @map("country_id") @db.Uuid
  recId      String    @map("rec_id") @db.Uuid
  joinedDate DateTime? @map("joined_date") @db.Timestamptz
  isActive   Boolean   @default(true) @map("is_active")
  country    Country   @relation(fields: [countryId], references: [id], onDelete: Cascade)
  rec        Rec       @relation(fields: [recId], references: [id], onDelete: Cascade)

  @@unique([countryId, recId])
  @@index([recId], map: "idx_country_rec_rec_id")
  @@map("country_recs")
  @@schema("governance")
}

model SystemConfig {
  id          String   @id @default(uuid()) @db.Uuid
  category    String   @db.VarChar(50)  // "general", "security", "notifications", "branding", "i18n", "data-quality"
  key         String   @db.VarChar(100) // "platform.name", "security.mfa.required", etc.
  value       Json
  label       Json     // { "en": "Platform Name", "fr": "Nom de la plateforme", ... }
  description Json?
  type        String   @db.VarChar(20)  // "string", "number", "boolean", "json", "color", "url", "enum"
  options     Json?    // for type "enum": ["option1", "option2"]
  isEditable  Boolean  @default(true) @map("is_editable")
  scope       String   @default("global") @db.VarChar(20) // "global", "rec", "national"
  tenantId    String?  @map("tenant_id") @db.Uuid
  validatedBy String?  @map("validated_by") @db.VarChar(255) // regex validation
  updatedBy   String?  @map("updated_by") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([category, key], map: "uq_config_category_key")
  @@index([category], map: "idx_system_config_category")
  @@index([tenantId], map: "idx_system_config_tenant_id")
  @@map("system_configs")
  @@schema("governance")
}

model Domain {
  id          String   @id @default(uuid()) @db.Uuid
  code        String   @unique @db.VarChar(30) // "animal-health", "livestock-prod", etc.
  name        Json     // { "en": "Animal Health & One Health", ... }
  description Json?
  icon        String   @db.VarChar(50)         // lucide icon name: "HeartPulse", "Wheat", etc.
  color       String   @db.VarChar(20)         // "#C62828"
  isActive    Boolean  @default(true) @map("is_active")
  sortOrder   Int      @default(0) @map("sort_order")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz
  userDomains UserDomain[]

  @@index([isActive], map: "idx_domain_is_active")
  @@index([sortOrder], map: "idx_domain_sort_order")
  @@map("domains")
  @@schema("governance")
}

model UserDomain {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  domainId   String   @map("domain_id") @db.Uuid
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz
  assignedBy String?  @map("assigned_by") @db.Uuid
  isActive   Boolean  @default(true) @map("is_active")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  domain     Domain   @relation(fields: [domainId], references: [id], onDelete: Cascade)

  @@unique([userId, domainId], map: "uq_user_domain")
  @@index([userId], map: "idx_user_domain_user_id")
  @@index([domainId], map: "idx_user_domain_domain_id")
  @@map("user_domains")
  @@schema("governance")
}

model AdminLevel {
  id          String   @id @default(uuid()) @db.Uuid
  countryId   String   @map("country_id") @db.Uuid
  level       Int      // 1-5
  name        Json     // { "en": "County", "fr": "Comté", ... }
  code        String   @db.VarChar(50) // "county", "sub_county", etc.
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz
  country     Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@unique([countryId, level])
  @@unique([countryId, code])
  @@index([countryId], map: "idx_admin_level_country_id")
  @@map("admin_levels")
  @@schema("governance")
}

// ── Functions (job titles / roles per hierarchical level) ────────────────

model Function {
  id          String         @id @default(uuid()) @db.Uuid
  code        String         @db.VarChar(30)
  name        Json           // { "en": "Director General", "fr": "Directeur Général", "pt": "...", "ar": "..." }
  description Json?
  level       String         @db.VarChar(20) // "continental", "regional", "national"
  category    String?        @db.VarChar(20) // "management", "technical", "data", "admin", "field"
  permissions Json?          // domain-specific permissions
  isActive    Boolean        @default(true) @map("is_active")
  isDefault   Boolean        @default(false) @map("is_default")
  sortOrder   Int            @default(0) @map("sort_order")
  tenantId    String         @map("tenant_id") @db.Uuid
  metadata    Json?
  createdAt   DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime       @updatedAt @map("updated_at") @db.Timestamptz
  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  users       UserFunction[]
  roles       FunctionRole[]

  @@unique([tenantId, code, level], map: "uq_function_code_level")
  @@index([level], map: "idx_function_level")
  @@index([isActive], map: "idx_function_is_active")
  @@index([tenantId], map: "idx_function_tenant_id")
  @@map("functions")
  @@schema("governance")
}

model UserFunction {
  id         String    @id @default(uuid()) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  functionId String    @map("function_id") @db.Uuid
  isPrimary  Boolean   @default(false) @map("is_primary")
  startDate  DateTime  @default(now()) @map("start_date") @db.Timestamptz
  endDate    DateTime? @map("end_date") @db.Timestamptz
  assignedBy String?   @map("assigned_by") @db.Uuid
  notes      String?
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  function   Function  @relation(fields: [functionId], references: [id], onDelete: Cascade)

  @@unique([userId, functionId], map: "uq_user_function")
  @@index([userId], map: "idx_user_function_user_id")
  @@index([functionId], map: "idx_user_function_function_id")
  @@map("user_functions")
  @@schema("governance")
}

// ── Roles & Permissions ───────────────────────────────────────────────

model Role {
  id          String    @id @default(uuid()) @db.Uuid
  code        String    @db.VarChar(50)
  name        Json      // { en, fr, pt, ar }
  description Json?
  level       String    @db.VarChar(20) // continental, regional, national
  color       String    @default("#6b7280") @db.VarChar(20)
  icon        String    @default("Shield") @db.VarChar(50)
  isSystem    Boolean   @default(false) @map("is_system")
  isActive    Boolean   @default(true) @map("is_active")
  sortOrder   Int       @default(0) @map("sort_order")
  tenantId    String?   @map("tenant_id") @db.Uuid
  metadata    Json?
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime  @updatedAt @map("updated_at") @db.Timestamptz
  tenant      Tenant?   @relation(fields: [tenantId], references: [id])
  permissions RolePermission[]
  functionRoles FunctionRole[]
  userRoles   UserRoleAssignment[]

  @@unique([tenantId, code], map: "uq_role_tenant_code")
  @@index([isActive], map: "idx_role_is_active")
  @@index([tenantId], map: "idx_role_tenant_id")
  @@map("roles")
  @@schema("governance")
}

model Permission {
  id          String    @id @default(uuid()) @db.Uuid
  module      String    @db.VarChar(50)
  feature     String    @db.VarChar(100)
  action      String    @db.VarChar(20)
  description Json?
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz
  rolePermissions RolePermission[]

  @@unique([module, feature, action], map: "uq_perm_module_feature_action")
  @@index([module], map: "idx_permission_module")
  @@map("permissions")
  @@schema("governance")
}

model RolePermission {
  id           String     @id @default(uuid()) @db.Uuid
  roleId       String     @map("role_id") @db.Uuid
  permissionId String     @map("permission_id") @db.Uuid
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId], map: "uq_role_permission")
  @@index([roleId], map: "idx_role_perm_role_id")
  @@index([permissionId], map: "idx_role_perm_perm_id")
  @@map("role_permissions")
  @@schema("governance")
}

model FunctionRole {
  id         String   @id @default(uuid()) @db.Uuid
  functionId String   @map("function_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  function   Function @relation(fields: [functionId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([functionId, roleId], map: "uq_function_role")
  @@index([functionId], map: "idx_func_role_function_id")
  @@index([roleId], map: "idx_func_role_role_id")
  @@map("function_roles")
  @@schema("governance")
}

model UserRoleAssignment {
  id         String   @id @default(uuid()) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  roleId     String   @map("role_id") @db.Uuid
  source     String   @default("direct") @db.VarChar(20) // "direct" | "function"
  assignedAt DateTime @default(now()) @map("assigned_at") @db.Timestamptz
  assignedBy String?  @map("assigned_by") @db.Uuid
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role       Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@unique([userId, roleId], map: "uq_user_role_assign")
  @@index([userId], map: "idx_user_role_user_id")
  @@index([roleId], map: "idx_user_role_role_id")
  @@map("user_role_assignments")
  @@schema("governance")
}

// ── BI Tools Configuration ──────────────────────────────────────────────

model BiToolConfig {
  id            String       @id @default(uuid()) @db.Uuid
  tool          String       @unique @db.VarChar(30) // "superset", "metabase", "grafana"
  baseUrl       String       @map("base_url") @db.VarChar(500)
  displayName   Json         @map("display_name")   // { "en": "Apache Superset", "fr": "..." }
  description   Json?
  icon          String?      @db.VarChar(50)         // lucide icon name
  status        String       @default("active") @db.VarChar(20) // "active", "coming_soon", "maintenance", "disabled"
  embedMode     String       @default("iframe") @map("embed_mode") @db.VarChar(30) // "iframe", "guest_token", "signed_url"
  sortOrder     Int          @default(0) @map("sort_order")
  metadata      Json?
  isActive      Boolean      @default(true) @map("is_active")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  accessRules   BiDataAccessRule[]
  dashboards    BiDashboard[]

  @@index([status], map: "idx_bi_tool_config_status")
  @@index([sortOrder], map: "idx_bi_tool_config_sort_order")
  @@map("bi_tool_configs")
  @@schema("governance")
}

model BiDataAccessRule {
  id                String       @id @default(uuid()) @db.Uuid
  biToolConfigId    String       @map("bi_tool_config_id") @db.Uuid
  roleLevel         String?      @map("role_level") @db.VarChar(30) // UserRole value
  entityType        String?      @map("entity_type") @db.VarChar(30) // "tenant", "rec", "country"
  entityId          String?      @map("entity_id") @db.Uuid
  allowedSchemas    Json         @default("[]") @map("allowed_schemas")   // ["public", "historical"]
  allowedTables     Json         @default("[]") @map("allowed_tables")    // ["outbreaks", "campaigns"]
  excludedTables    Json         @default("[]") @map("excluded_tables")   // ["User", "Session"]
  dataFilters       Json?        @map("data_filters")   // RLS-like filters
  canCreateDashboard Boolean     @default(false) @map("can_create_dashboard")
  canExportData     Boolean      @default(false) @map("can_export_data")
  canUseSqlLab      Boolean      @default(false) @map("can_use_sql_lab")
  isActive          Boolean      @default(true) @map("is_active")
  createdAt         DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  biToolConfig      BiToolConfig @relation(fields: [biToolConfigId], references: [id], onDelete: Cascade)

  @@unique([biToolConfigId, roleLevel, entityType, entityId], map: "uq_bi_access_rule")
  @@index([biToolConfigId], map: "idx_bi_access_rule_tool_id")
  @@index([roleLevel], map: "idx_bi_access_rule_role")
  @@map("bi_data_access_rules")
  @@schema("governance")
}

model BiDashboard {
  id              String       @id @default(uuid()) @db.Uuid
  biToolConfigId  String       @map("bi_tool_config_id") @db.Uuid
  externalId      String       @map("external_id") @db.VarChar(255) // ID in Superset/Metabase
  name            Json         // { "en": "Animal Health Overview", "fr": "..." }
  description     Json?
  thumbnail       String?      @db.VarChar(500)
  category        String?      @db.VarChar(50)    // "animal-health", "livestock", "overview"
  embedUrl        String       @map("embed_url") @db.VarChar(1000)
  scope           String       @default("global") @db.VarChar(20) // "global", "rec", "national"
  allowedRoles    Json         @default("[]") @map("allowed_roles") // ["SUPER_ADMIN", "ANALYST"]
  sortOrder       Int          @default(0) @map("sort_order")
  isFeatured      Boolean      @default(false) @map("is_featured")
  isActive        Boolean      @default(true) @map("is_active")
  createdAt       DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt       DateTime     @updatedAt @map("updated_at") @db.Timestamptz
  biToolConfig    BiToolConfig @relation(fields: [biToolConfigId], references: [id], onDelete: Cascade)

  @@unique([biToolConfigId, externalId], map: "uq_bi_dashboard_external")
  @@index([biToolConfigId], map: "idx_bi_dashboard_tool_id")
  @@index([category], map: "idx_bi_dashboard_category")
  @@index([scope], map: "idx_bi_dashboard_scope")
  @@index([isFeatured], map: "idx_bi_dashboard_featured")
  @@map("bi_dashboards")
  @@schema("governance")
}

// ── Statistic Definitions & Country Statistics ──────────────────────────

model StatisticDefinition {
  id            String   @id @default(uuid()) @db.Uuid
  code          String   @unique @db.VarChar(50)
  name          Json     // { en, fr, pt, ar }
  description   Json?
  domainCode    String   @map("domain_code") @db.VarChar(30)
  icon          String?  @db.VarChar(50)
  color         String?  @db.VarChar(20)
  unit          String   @default("count") @db.VarChar(20)  // count, percentage, currency, tonnes
  format        String   @default("number") @db.VarChar(20) // number, currency, compact
  sourceType    String   @map("source_type") @db.VarChar(20) // form_builder, manual
  sourceConfig  Json?    @map("source_config") // { templateId?, fieldCode?, aggregation: "count"|"sum"|"avg" }
  isActive      Boolean  @default(true) @map("is_active")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz
  countryStats  CountryStatistic[]

  @@index([domainCode], map: "idx_stat_def_domain")
  @@index([isActive], map: "idx_stat_def_active")
  @@map("statistic_definitions")
  @@schema("governance")
}

model CountryStatistic {
  id            String   @id @default(uuid()) @db.Uuid
  countryId     String   @map("country_id") @db.Uuid
  statisticId   String   @map("statistic_id") @db.Uuid
  isVisible     Boolean  @default(true) @map("is_visible")
  displayPeriod String   @default("current_year") @map("display_period") @db.VarChar(30)
  periodStart   DateTime? @map("period_start") @db.Timestamptz
  periodEnd     DateTime? @map("period_end") @db.Timestamptz
  overrideValue Float?   @map("override_value")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz
  country       Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  statistic     StatisticDefinition @relation(fields: [statisticId], references: [id], onDelete: Cascade)

  @@unique([countryId, statisticId])
  @@index([countryId], map: "idx_country_stat_country")
  @@map("country_statistics")
  @@schema("governance")
}

// ── KPI Definitions & Country KPI Scores ────────────────────────────────

model KpiDefinition {
  id            String   @id @default(uuid()) @db.Uuid
  code          String   @unique @db.VarChar(50)
  name          Json     // { en, fr, pt, ar }
  description   Json?
  domainCode    String?  @map("domain_code") @db.VarChar(30)
  icon          String?  @db.VarChar(50)
  color         String?  @db.VarChar(20)
  unit          String   @default("percentage") @db.VarChar(20)
  targetValue   Float    @default(100) @map("target_value")
  thresholdGood Int      @default(75) @map("threshold_good")
  thresholdWarn Int      @default(50) @map("threshold_warn")
  scope         String   @default("both") @db.VarChar(20) // country, rec, both
  isPreset      Boolean  @default(false) @map("is_preset")
  isActive      Boolean  @default(true) @map("is_active")
  sortOrder     Int      @default(0) @map("sort_order")
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt     DateTime @updatedAt @map("updated_at") @db.Timestamptz
  countryScores CountryKpiScore[]

  @@index([domainCode], map: "idx_kpi_def_domain")
  @@index([isActive], map: "idx_kpi_def_active")
  @@map("kpi_definitions")
  @@schema("governance")
}

model CountryKpiScore {
  id         String   @id @default(uuid()) @db.Uuid
  countryId  String   @map("country_id") @db.Uuid
  kpiId      String   @map("kpi_id") @db.Uuid
  score      Float    // 0-100
  year       Int
  quarter    Int?
  source     String   @default("manual") @db.VarChar(20) // manual, computed
  notes      String?
  updatedBy  String?  @map("updated_by") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz
  country    Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  kpi        KpiDefinition @relation(fields: [kpiId], references: [id], onDelete: Cascade)

  @@unique([countryId, kpiId, year, quarter])
  @@index([countryId], map: "idx_kpi_score_country")
  @@index([kpiId], map: "idx_kpi_score_kpi")
  @@map("country_kpi_scores")
  @@schema("governance")
}
