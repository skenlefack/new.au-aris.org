// ARIS 4.0 — AI Orchestrator Schema
// Audit logging for AI usage and generation drafts

enum AiUsageStatus {
  SUCCESS
  FAILED
  TIMEOUT

  @@schema("ai")
}

enum AiDraftType {
  FORM
  CAMPAIGN
  INDICATOR
  DASHBOARD

  @@schema("ai")
}

enum AiDraftStatus {
  DRAFT
  ACCEPTED
  REJECTED
  EXPIRED

  @@schema("ai")
}

enum MlModelType {
  XGBOOST
  ISOLATION_FOREST
  HDBSCAN
  CHRONOS
  PROPHET

  @@schema("ai")
}

enum MlModelStatus {
  TRAINING
  READY
  FAILED
  DEPRECATED

  @@schema("ai")
}

enum MlJobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED

  @@schema("ai")
}

enum MlJobTrigger {
  SCHEDULE
  MANUAL

  @@schema("ai")
}

model AiUsageLog {
  id            String        @id @default(uuid()) @db.Uuid
  userId        String        @db.Uuid
  endpoint      String        @db.VarChar(255)
  model         String        @db.VarChar(128)
  tokensInput   Int           @default(0)
  tokensOutput  Int           @default(0)
  durationMs    Int           @default(0)
  status        AiUsageStatus @default(SUCCESS)
  createdAt     DateTime      @default(now()) @db.Timestamptz(3)

  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("ai_usage_logs")
  @@schema("ai")
}

model AiGenerationDraft {
  id          String        @id @default(uuid()) @db.Uuid
  userId      String        @db.Uuid
  type        AiDraftType
  prompt      String        @db.Text
  output      Json          @default("{}")
  status      AiDraftStatus @default(DRAFT)
  createdAt   DateTime      @default(now()) @db.Timestamptz(3)
  acceptedAt  DateTime?     @db.Timestamptz(3)
  rejectedAt  DateTime?     @db.Timestamptz(3)

  @@index([userId, status])
  @@index([type, status])
  @@index([createdAt])
  @@map("ai_generation_drafts")
  @@schema("ai")
}

model MlModel {
  id           String        @id @default(uuid()) @db.Uuid
  code         String        @unique @db.VarChar(128)
  name         String        @db.VarChar(255)
  type         MlModelType
  version      String        @db.VarChar(32) @default("1.0.0")
  status       MlModelStatus @default(TRAINING)
  trainedAt    DateTime?     @db.Timestamptz(3)
  accuracy     Float?
  metrics      Json          @default("{}")
  artifactPath String?       @db.VarChar(512)
  config       Json          @default("{}")
  createdAt    DateTime      @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime      @updatedAt @db.Timestamptz(3)

  trainingJobs MlTrainingJob[]

  @@index([type, status])
  @@index([code])
  @@map("ml_models")
  @@schema("ai")
}

model MlTrainingJob {
  id            String       @id @default(uuid()) @db.Uuid
  modelId       String       @db.Uuid
  model         MlModel      @relation(fields: [modelId], references: [id], onDelete: Cascade)
  status        MlJobStatus  @default(PENDING)
  triggeredBy   MlJobTrigger @default(SCHEDULE)
  startedAt     DateTime?    @db.Timestamptz(3)
  completedAt   DateTime?    @db.Timestamptz(3)
  durationMs    Int?
  inputRowCount Int?
  errorMessage  String?      @db.Text
  metrics       Json         @default("{}")
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)

  @@index([modelId, status])
  @@index([createdAt])
  @@map("ml_training_jobs")
  @@schema("ai")
}
