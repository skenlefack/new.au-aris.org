// ARIS 4.0 — Fisheries & Aquaculture domain schema
// Service: fisheries (port 3022)
// Owner: CC-4

model FishCapture {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  geoEntityId        String   @map("geo_entity_id") @db.Uuid
  speciesId          String   @map("species_id") @db.Uuid
  faoAreaCode        String   @map("fao_area_code")
  vesselId           String?  @map("vessel_id") @db.Uuid
  captureDate        DateTime @map("capture_date") @db.Timestamptz
  quantityKg         Float    @map("quantity_kg")
  gearType           String   @map("gear_type")
  landingSite        String   @map("landing_site")
  fishingEnvironment String?  @map("fishing_environment") @db.VarChar(30)  // MARINE, INLAND, BRACKISH
  productionType     String?  @map("production_type") @db.VarChar(30)      // ARTISANAL, INDUSTRIAL, SUBSISTENCE
  status             String   @default("DRAFT") @map("status") @db.VarChar(20) // DRAFT, SUBMITTED, VALIDATED
  dataClassification String   @default("PARTNER") @map("data_classification")
  createdBy          String   @map("created_by") @db.Uuid
  updatedBy          String   @map("updated_by") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([tenantId])
  @@index([geoEntityId])
  @@index([speciesId])
  @@index([captureDate])
  @@index([faoAreaCode])
  @@map("fish_captures")
  @@schema("fisheries")
}

model FishingVessel {
  id                  String    @id @default(uuid()) @db.Uuid
  tenantId            String    @map("tenant_id") @db.Uuid
  name                String
  registrationNumber  String    @unique @map("registration_number")
  flagState           String    @map("flag_state")
  vesselType          String    @map("vessel_type")
  lengthMeters        Float     @map("length_meters")
  tonnageGt           Float     @map("tonnage_gt")
  homePort            String    @map("home_port")
  licenseNumber       String?   @map("license_number")
  licenseExpiry       DateTime? @map("license_expiry") @db.Timestamptz
  enginePowerKw       Float?    @map("engine_power_kw")
  crewCapacity        Int?      @map("crew_capacity")
  ownerName           String?   @map("owner_name") @db.VarChar(255)
  isActive            Boolean   @default(true) @map("is_active")
  dataClassification  String    @default("PARTNER") @map("data_classification")
  createdBy           String    @map("created_by") @db.Uuid
  updatedBy           String    @map("updated_by") @db.Uuid
  createdAt           DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@index([tenantId])
  @@index([flagState])
  @@index([isActive])
  @@map("fishing_vessels")
  @@schema("fisheries")
}

model AquacultureFarm {
  id                      String   @id @default(uuid()) @db.Uuid
  tenantId                String   @map("tenant_id") @db.Uuid
  name                    String
  geoEntityId             String   @map("geo_entity_id") @db.Uuid
  coordinates             Json?    @default("{}")
  farmType                String   @map("farm_type")
  waterSource             String   @map("water_source")
  areaHectares            Float    @map("area_hectares")
  speciesIds              String[] @map("species_ids") @db.Uuid
  productionCapacityTonnes Float   @map("production_capacity_tonnes")
  ownerName               String?  @map("owner_name") @db.VarChar(255)
  registrationNumber      String?  @map("registration_number") @db.VarChar(100)
  totalWorkers            Int?     @map("total_workers")
  maleWorkers             Int?     @map("male_workers")
  femaleWorkers           Int?     @map("female_workers")
  pondCount               Int?     @map("pond_count")
  isActive                Boolean  @default(true) @map("is_active")
  dataClassification      String   @default("PARTNER") @map("data_classification")
  createdBy               String   @map("created_by") @db.Uuid
  updatedBy               String   @map("updated_by") @db.Uuid
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt               DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([tenantId])
  @@index([geoEntityId])
  @@index([isActive])
  @@map("aquaculture_farms")
  @@schema("fisheries")
}

model AquacultureProduction {
  id                 String    @id @default(uuid()) @db.Uuid
  tenantId           String    @map("tenant_id") @db.Uuid
  farmId             String    @map("farm_id") @db.Uuid
  speciesId          String    @map("species_id") @db.Uuid
  harvestDate        DateTime  @map("harvest_date") @db.Timestamptz
  quantityKg         Float     @map("quantity_kg")
  methodOfCulture    String    @map("method_of_culture")
  feedUsedKg         Float?    @map("feed_used_kg")
  fcr                Float?
  batchId            String?   @map("batch_id")
  stockingDate       DateTime? @map("stocking_date") @db.Timestamptz
  survivalRate       Float?    @map("survival_rate")
  averageWeightGrams Float?    @map("average_weight_grams")
  dataClassification String    @default("PARTNER") @map("data_classification")
  createdBy          String    @map("created_by") @db.Uuid
  updatedBy          String    @map("updated_by") @db.Uuid
  createdAt          DateTime  @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime  @updatedAt @map("updated_at") @db.Timestamptz

  @@index([tenantId])
  @@index([farmId])
  @@index([speciesId])
  @@index([harvestDate])
  @@map("aquaculture_production")
  @@schema("fisheries")
}

model FishingEffort {
  id                 String   @id @default(uuid()) @db.Uuid
  tenantId           String   @map("tenant_id") @db.Uuid
  captureId          String?  @map("capture_id") @db.Uuid
  vesselId           String?  @map("vessel_id") @db.Uuid
  effortType         String   @map("effort_type") @db.VarChar(50)
  effortValue        Float    @map("effort_value")
  effortUnit         String   @map("effort_unit") @db.VarChar(30)
  startDate          DateTime @map("start_date") @db.Timestamptz
  endDate            DateTime @map("end_date") @db.Timestamptz
  gearType           String   @map("gear_type") @db.VarChar(50)
  crewSize           Int?     @map("crew_size")
  faoAreaCode        String?  @map("fao_area_code") @db.VarChar(20)
  dataClassification String   @default("PARTNER") @map("data_classification") @db.VarChar(20)
  createdBy          String   @map("created_by") @db.Uuid
  updatedBy          String   @map("updated_by") @db.Uuid
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@index([tenantId])
  @@index([vesselId])
  @@index([captureId])
  @@index([startDate])
  @@map("fishing_efforts")
  @@schema("fisheries")
}
